{
  "permissions": {
    "deny": [
      "Bash(*SendKeys*)",
      "Bash(*SendWait*)"
    ],
    "ask": [
      "Bash(*--replace*)",
      "Bash(*place.py*)",
      "Bash(*apply.py*)",
      "Bash(*DeleteClips*)",
      "Bash(*DeleteTimelines*)",
      "Bash(*ClearTrack*)",
      "Bash(*reframe.py*--apply*)",
      "Bash(*grade.py apply*)",
      "Bash(*after_gen.py finish*)",
      "Bash(*gen_swap.py*--apply*)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "context-mode@context-mode": false,
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.work/tools/memory_gateway.py",
              "startup"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
