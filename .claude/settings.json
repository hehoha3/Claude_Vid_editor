{
  "permissions": {
    "deny": [
      "Bash(*SendKeys*)",
      "Bash(*SendWait*)"
    ],
    "ask": [
      "Bash(*--replace*)",
      "Bash(*place.py*)",
      "Bash(*apply.py*)",
      "Bash(*DeleteClips*)",
      "Bash(*DeleteTimelines*)",
      "Bash(*ClearTrack*)",
      "Bash(*reframe.py*--apply*)",
      "Bash(*grade.py apply*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.work/tools/memory_gateway.py",
              "startup"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
